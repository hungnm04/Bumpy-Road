# AlpineScout - Root Environment Variables
# Copy this file to .env and fill in the values

NODE_ENV=production
PORT=5000

# Client origins - comma-separated list of allowed frontend URLs
# For local development: http://localhost
# For production: https://yourdomain.com,https://www.yourdomain.com
CLIENT_ORIGINS=http://localhost

# Database Configuration
DB_USER=bumpyroad
DB_HOST=db
DB_NAME=bumpyroad
DB_PASSWORD=replace-with-a-strong-database-password-min-16-chars
DB_PORT=5432
DB_SSL=false

# JWT Configuration - MUST be at least 32 characters each
JWT_SECRET=replace-with-at-least-32-random-characters-here
JWT_REFRESH_SECRET=replace-with-another-32-random-characters-here

# Admin User Configuration (used for initial setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_FIRST_NAME=Bumpy
ADMIN_LAST_NAME=Admin

# Ingestion Configuration
INGEST_USER_AGENT=BumpyRoad/1.0 (contact: admin@example.com)
INGEST_ALLOWED_HOSTS=query.wikidata.org,www.wikidata.org,commons.wikimedia.org,api.open-meteo.com
